# ---------------------------------------------------------------------------
# AfriAgent environment
#
# Everything here is OPTIONAL in development. With no config at all the app
# runs against an in-process PGlite database and the WhatsApp simulator, so
# you can run `npm run db:seed` and `npm run dev` with no setup at all.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Set this and you are on real Postgres (Neon / Supabase / self-hosted).
# Leave it unset in dev and PGlite is used instead.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Where PGlite stores its data directory when DATABASE_URL is unset.
# PGLITE_PATH=.data/pglite

# Migrations are applied out of process by `npm run db:migrate`. The app only
# warns if the schema looks behind, so this is how you apply them.
# SKIP_AUTO_MIGRATE=1 silences even that.

# `npm run db:seed` refuses to run when DATABASE_URL is set, because it
# deletes tenant data. Override deliberately.
# ALLOW_SEED_ON_DATABASE_URL=1

# --- AI provider (NVIDIA NIM) --------------------------------------------
# NIM is OpenAI-compatible and supports native tool calling, so the adapter in
# src/ai/nvidia.ts is a thin translation. Works against the hosted endpoint or
# a self-hosted NIM container -- only the base URL differs.
#
# The API key is normally set at /admin/platform and stored encrypted. The env
# var below is only a bootstrap path for a fresh deployment, and a saved key
# takes precedence -- which is how rotation works without a redeploy.
#
# Without either, the assistant does not answer questions; it escalates to a
# human instead. That is deliberate: silence is worse than a queued handoff.
#
# Free keys are TRIAL ONLY -- prototyping and testing. Production use needs an
# NVIDIA AI Enterprise licence (~US$4,500/GPU/year, or ~US$1/GPU-hour). Price
# this before depending on it commercially.
# NVIDIA_API_KEY=

# Encrypts platform secrets at rest. MUST stay in the environment -- a key that
# encrypts keys cannot be stored beside the things it protects. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PLATFORM_SECRETS_KEY=

# Who may reach /admin/platform. Comma-separated, case-insensitive. Empty
# means nobody, which is the safe default. Deliberately an env var and not a
# table: who administers the platform is a deployment decision, not something
# a database compromise should be able to rewrite.
# PLATFORM_ADMIN_EMAILS=you@example.com

# Must match a model available to your key. Prefer setting this at
# /admin/platform; these env vars are the bootstrap fallback. Check what your
# key can reach with:
#   curl -s -H "Authorization: Bearer $NVIDIA_API_KEY" https://integrate.api.nvidia.com/v1/models
# The default below is a guess and is probably stale -- run `npm run ai:check`.
# AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_TIMEOUT_MS=20000

# Chat-template kwarg used to disable "detailed thinking" when tools are sent.
# NVIDIA documents that tool calling on the Nemotron families only works with
# thinking off. The kwarg NAME differs by model family, so if tool calling fails
# try the other spelling. Set to an empty value to send nothing.
#   enable_thinking  Qwen3 / Nemotron templates (default)
#   thinking         GLM-style templates
# AI_THINKING_PARAM=enable_thinking

# Tokens per tenant per day before the provider stops being called.
# AI_DAILY_TOKEN_BUDGET=200000

# --- Email ------------------------------------------------------------------
# Resend is wired up. Set EMAIL_PROVIDER=resend to use it in any environment
# (including dev, so the real path can be exercised without a deploy).
#
# Leave EMAIL_PROVIDER unset and development logs mail to the console while
# production refuses to send. That is deliberate: sending real mail should never
# happen by accident.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# Verified sender. On Resend's free tier you can only send to your own address
# until you verify a domain, so this must be a domain you control in
# production or every send will bounce.
# EMAIL_FROM=AfriAgent <no-reply@afriagent.com>

# Public base URL, used to build verification and reset links. Without it,
# links point at localhost and will not work for real users.
# APP_URL=https://app.afriagent.com

# --- Scheduled jobs -------------------------------------------------------
# Required by GET /api/cron/daily-summary. The endpoint fails closed without
# it -- an unauthenticated route here means anyone on the internet can trigger
# messages to real customers' phones.
# CRON_SECRET=

# --- WhatsApp Cloud API -----------------------------------------------------
# Only needed once you have a WABA from business.facebook.com/whatsapp.
# Until then, sends are simulated and logged to the terminal.
#
# Permanent token from the WABA's API keys page.
# WHATSAPP_ACCESS_TOKEN=
#
# The phone_number_id from your WhatsApp Business Account.
# WHATSAPP_PHONE_NUMBER_ID=

# App secret, used to verify the X-Hub-Signature-256 header on webhooks.
# REQUIRED in production: without it, all webhook POST requests are rejected.
# WHATSAPP_APP_SECRET=

# The verify token you choose when registering the webhook in Meta's dashboard.
# WHATSAPP_VERIFY_TOKEN=

# Graph API version. Pin this so a Meta upgrade cannot change payload shapes
# under you.
# WHATSAPP_GRAPH_VERSION=v23.0
